# Default API target: the live Cloud Run deployment (migrated off Railway
# 2026-08-21). Not a secret — this is a public HTTPS endpoint, same one
# already exercised throughout the backend build.
#
# To point at a local backend instead (e.g. while changing the Java side),
# create a .env.local with VITE_API_BASE_URL=http://localhost:8080 — Vite
# gitignores *.local by default, so that override never gets committed.
VITE_API_BASE_URL=https://masters-api-993567008616.me-west1.run.app
