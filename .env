# Default API target: the live Railway deployment. Not a secret — this is a
# public HTTPS endpoint, same one already exercised throughout the backend build.
#
# To point at a local backend instead (e.g. while changing the Java side),
# create a .env.local with VITE_API_BASE_URL=http://localhost:8080 — Vite
# gitignores *.local by default, so that override never gets committed.
VITE_API_BASE_URL=https://masters-api-production.up.railway.app
